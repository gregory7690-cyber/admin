<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rewards — Novelora Admin</title>

  <link rel="stylesheet" href="style.css">

  <style>
    .rewards-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 24px;
    }

    .reward-stat {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      padding: 22px;
    }

    .reward-stat span {
      display: block;
      color: #aaa;
      font-size: 12px;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .reward-stat strong {
      display: block;
      color: #fff;
      font-size: 28px;
    }

    .reward-stat p {
      color: #888;
      font-size: 13px;
      margin: 7px 0 0;
    }

    .rewards-layout {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .reward-panel {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 24px;
    }

    .reward-panel h2 {
      color: #fff;
      margin: 0 0 6px;
    }

    .reward-panel > p {
      color: #888;
      font-size: 13px;
      margin: 0 0 22px;
    }

    .reward-row {
      display: grid;
      grid-template-columns: 1fr 100px 80px;
      gap: 15px;
      align-items: center;
      padding: 15px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .reward-row:last-child {
      border-bottom: none;
    }

    .reward-info strong {
      display: block;
      color: #fff;
      margin-bottom: 4px;
    }

    .reward-info span {
      color: #888;
      font-size: 12px;
    }

    .reward-coins {
      color: #f29ab7;
      font-weight: 700;
      text-align: center;
    }

    .reward-status {
      color: #8fd8a7;
      font-size: 12px;
      text-align: right;
    }

    .settings-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group label {
      display: block;
      color: #ccc;
      font-size: 13px;
      margin-bottom: 7px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(0,0,0,0.2);
      color: #fff;
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: rgba(242,154,183,0.7);
    }

    .save-button {
      border: none;
      border-radius: 11px;
      padding: 13px 18px;
      background: linear-gradient(135deg, #ed82a8, #b85c89);
      color: white;
      font-weight: 700;
      cursor: pointer;
    }

    .save-button:hover {
      opacity: 0.9;
    }

    .checkin-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 10px;
      margin-top: 18px;
    }

    .checkin-day {
      padding: 15px 8px;
      text-align: center;
      border-radius: 12px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.07);
    }

    .checkin-day strong {
      display: block;
      color: #fff;
      font-size: 13px;
      margin-bottom: 7px;
    }

    .checkin-day span {
      color: #f29ab7;
      font-weight: 700;
    }

    .reward-note {
      padding: 15px;
      border-radius: 12px;
      background: rgba(242,154,183,0.07);
      border: 1px solid rgba(242,154,183,0.12);
      color: #aaa;
      font-size: 13px;
      line-height: 1.6;
      margin-top: 18px;
    }

    .empty-rewards {
      text-align: center;
      padding: 45px 20px;
      color: #888;
    }

    .empty-rewards .symbol {
      font-size: 40px;
      color: #e88aaa;
      margin-bottom: 10px;
    }

    .empty-rewards h3 {
      color: #fff;
      margin: 0 0 8px;
    }

    @media (max-width: 1000px) {
      .rewards-stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .rewards-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .rewards-stats {
        grid-template-columns: 1fr;
      }

      .reward-row {
        grid-template-columns: 1fr auto;
      }

      .reward-status {
        display: none;
      }

      .checkin-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
  </style>
</head>

<body>

<div class="admin-app">

  <!-- SIDEBAR -->
  <aside class="admin-sidebar">

    <div class="admin-brand">
      <div class="brand-name">NOVEL<span>ORA</span></div>
