      </a>

      <a href="readers.html" class="nav-item">
        <span>♙</span>
        <span>Readers</span>
      </a>

      <a href="authors.html" class="nav-item">
        <span>✎</span>
        <span>Authors</span>
      </a>

      <a href="community.html" class="nav-item">
        <span>♡</span>
        <span>Community</span>
      </a>

      <div class="nav-divider"></div>

      <a href="notifications.html" class="nav-item">
        <span>♢</span>
        <span>Notifications</span>
      </a>

      <a href="money.html" class="nav-item">
        <span>₵</span>
        <span>Money</span>
      </a>

      <a href="analytics.html" class="nav-item">
        <span>↗</span>
        <span>Analytics</span>
      </a>

      <a href="rewards.html" class="nav-item active">
        <span>✦</span>
        <span>Rewards</span>
      </a>

      <a href="promotions.html" class="nav-item">
        <span>♢</span>
        <span>Promotions</span>
      </a>

      <div class="nav-divider"></div>

      <a href="settings.html" class="nav-item">
        <span>⚙</span>
        <span>Settings</span>
      </a>

      <a href="security.html" class="nav-item">
        <span>♙</span>
        <span>Security</span>
      </a>

    </nav>

    <div class="sidebar-footer">
      <div class="admin-avatar">N</div>

      <div>
        <strong>Novelora Admin</strong>
        <small>Administrator</small>
      </div>
    </div>

  </aside>


  <!-- MAIN -->
  <main class="admin-main">

    <header class="admin-topbar">

      <div>
        <div class="page-kicker">NOVELORA REWARDS</div>

        <h1>Rewards 🎁</h1>

        <p>
          Manage the free coins and reward programs available to readers.
        </p>
      </div>

      <div class="topbar-actions">

        <button
          class="icon-button"
          title="Notifications"
          onclick="location.href='notifications.html'"
        >
          ♢
        </button>

        <div class="admin-user">

          <div class="admin-user-avatar">N</div>

          <div>
            <strong>Admin</strong>
            <small>Administrator</small>
          </div>

        </div>

      </div>

    </header>


    <!-- STATS -->
    <section class="rewards-stats">

      <div class="reward-stat">
        <span>COINS DISTRIBUTED</span>
        <strong id="coinsDistributed">0</strong>
        <p>Total recorded reward coins</p>
      </div>

      <div class="reward-stat">
        <span>REWARD CLAIMS</span>
        <strong id="rewardClaims">0</strong>
        <p>Recorded reward events</p>
      </div>

      <div class="reward-stat">
        <span>DAILY LOGIN</span>
        <strong id="dailyLoginReward">2</strong>
        <p>Coins per daily login</p>
      </div>

      <div class="reward-stat">
        <span>NEW USER BONUS</span>
        <strong id="newUserBonus">20</strong>
        <p>Coins for new readers</p>
      </div>

    </section>


    <section class="rewards-layout">

      <!-- REWARD PROGRAMS -->
      <div class="reward-panel">

        <h2>Reward Programs</h2>

        <p>
          Current Novelora reader reward structure.
        </p>

        <div class="reward-row">

          <div class="reward-info">
            <strong>Daily Login</strong>
            <span>Reward readers for returning each day.</span>
          </div>

          <div class="reward-coins">2 coins</div>

          <div class="reward-status">Active</div>

        </div>

        <div class="reward-row">

          <div class="reward-info">
            <strong>Rewarded Ad</strong>
            <span>Coins after a completed rewarded advertisement.</span>
          </div>

          <div class="reward-coins">2 coins</div>

          <div class="reward-status">Active</div>

        </div>

        <div class="reward-row">

          <div class="reward-info">
            <strong>Share to Earn</strong>
            <span>Reward genuine sharing activity.</span>
          </div>

          <div class="reward-coins">2 coins</div>

          <div class="reward-status">Active</div>

        </div>

        <div class="reward-row">

          <div class="reward-info">
            <strong>New Reader Bonus</strong>
            <span>One-time welcome reward for a new reader.</span>
          </div>

          <div class="reward-coins">20 coins</div>

          <div class="reward-status">Active</div>

        </div>

      </div>


      <!-- SETTINGS -->
      <div class="reward-panel">

        <h2>Reward Settings</h2>

        <p>
          Adjust reward values before the real reward system goes live.
        </p>

        <form id="rewardSettingsForm" class="settings-form">

          <div class="form-group">
            <label for="dailyLogin">
              Daily Login Coins
            </label>

            <input
              id="dailyLogin"
              type="number"
              min="0"
              value="2"
              required
            >
          </div>

          <div class="form-group">
            <label for="adReward">
              Rewarded Ad Coins
            </label>

            <input
              id="adReward"
              type="number"
              min="0"
              value="2"
              required
            >
          </div>

          <div class="form-group">
            <label for="shareReward">
              Share Reward Coins
            </label>

            <input
              id="shareReward"
              type="number"
              min="0"
              value="2"
              required
            >
          </div>

          <div class="form-group">
            <label for="newUser">
              New User Bonus
            </label>

            <input
              id="newUser"
              type="number"
              min="0"
              value="20"
              required
            >
          </div>

          <button
            type="submit"
            class="save-button"
          >
            Save Reward Settings
          </button>

        </form>

        <div
          id="settingsMessage"
          class="reward-note"
          style="display:none;"
        ></div>

      </div>

    </section>


    <!-- 7 DAY CHECK-IN -->
    <section class="reward-panel" style="margin-bottom:24px;">

      <h2>7-Day Check-In</h2>

      <p>
        Readers receive a reward for maintaining their daily check-in.
      </p>

      <div class="checkin-grid">

        <div class="checkin-day">
          <strong>Day 1</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 2</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 3</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 4</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 5</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 6</strong>
          <span>2 🪙</span>
        </div>

        <div class="checkin-day">
          <strong>Day 7</strong>
          <span>5 🪙</span>
        </div>

      </div>

      <div class="reward-note">
        The check-in cycle resets after Day 7. The actual reader-side
        claiming system will be connected when the reader reward system
        is implemented.
      </div>

    </section>


    <!-- REWARD HISTORY -->
    <section class="reward-panel">

      <h2>Reward History</h2>

      <p>
        Real reward activity will appear here once readers begin claiming rewards.
      </p>

      <div id="rewardHistory">

        <div class="empty-rewards">

          <div class="symbol">✦</div>

          <h3>No reward activity yet</h3>

          <p>
            Reward claims and coin distributions will appear here.
          </p>

        </div>

      </div>

    </section>

  </main>

</div>


<script>

const REWARD_SETTINGS_KEY =
  "noveloraRewardSettings";

const REWARD_HISTORY_KEY =
  "noveloraRewardHistory";


function getData(key) {

  try {

    const data =
      localStorage.getItem(key);

    return data
      ? JSON.parse(data)
      : [];

  } catch {

    return [];

  }

}


function saveData(key, data) {

  localStorage.setItem(
    key,
    JSON.stringify(data)
  );

}


function getSettings() {

  try {

    const data =
      localStorage.getItem(
        REWARD_SETTINGS_KEY
      );

    return data
      ? JSON.parse(data)
      : {
          dailyLogin: 2,
          adReward: 2,
          shareReward: 2,
          newUser: 20
        };

  } catch {

    return {
      dailyLogin: 2,
      adReward: 2,
      shareReward: 2,
      newUser: 20
    };

  }

}


function updateStats() {

  const settings =
    getSettings();

  const history =
    getData(REWARD_HISTORY_KEY);


  const coins =
    history.reduce(
      (total, reward) =>
        total +
        Number(reward.coins || 0),
      0
    );


  document.querySelector(
    "#coinsDistributed"
  ).textContent =
    coins.toLocaleString();


  document.querySelector(
    "#rewardClaims"
  ).textContent =
    history.length;


  document.querySelector(
    "#dailyLoginReward"
  ).textContent =
    settings.dailyLogin;


  document.querySelector(
    "#newUserBonus"
  ).textContent =
    settings.newUser;


  document.querySelector(
    "#dailyLogin"
  ).value =
    settings.dailyLogin;


  document.querySelector(
    "#adReward"
  ).value =
    settings.adReward;


  document.querySelector(
    "#shareReward"
  ).value =
    settings.shareReward;


  document.querySelector(
    "#newUser"
  ).value =
    settings.newUser;


  renderHistory(history);

}


function renderHistory(history) {

  const container =
    document.querySelector(
      "#rewardHistory"
    );


  if (!history.length) {

    container.innerHTML = `
      <div class="empty-rewards">

        <div class="symbol">✦</div>

        <h3>No reward activity yet</h3>

        <p>
          Reward claims and coin distributions will appear here.
        </p>

      </div>
    `;

    return;

  }


  container.innerHTML =
    history
      .slice(0, 20)
      .map(reward => `

        <div class="reward-row">

          <div class="reward-info">

            <strong>
              ${escapeHTML(
                reward.type ||
                "Reward"
              )}
            </strong>

            <span>
              ${reward.date
                ? new Date(
                    reward.date
                  ).toLocaleString()
                : "Unknown date"}
            </span>

          </div>

          <div class="reward-coins">
            +${Number(
              reward.coins || 0
            )} coins
          </div>

          <div class="reward-status">
            ${escapeHTML(
              reward.status ||
              "Completed"
            )}
          </div>

        </div>

      `)
      .join("");

}


function escapeHTML(value) {

  const div =
    document.createElement(
      "div"
    );

  div.textContent =
    value ?? "";

  return div.innerHTML;

}


document
  .querySelector(
    "#rewardSettingsForm"
  )
  .addEventListener(
    "submit",
    event => {

      event.preventDefault();


      const settings = {

        dailyLogin:
          Number(
            document.querySelector(
              "#dailyLogin"
            ).value
          ),

        adReward:
          Number(
            document.querySelector(
              "#adReward"
            ).value
          ),

        shareReward:
          Number(
            document.querySelector(
              "#shareReward"
            ).value
          ),

        newUser:
          Number(
            document.querySelector(
              "#newUser"
            ).value
          )

      };


      saveData(
        REWARD_SETTINGS_KEY,
        settings
      );


      const message =
        document.querySelector(
          "#settingsMessage"
        );


      message.textContent =
        "Reward settings saved successfully.";


      message.style.display =
        "block";


      updateStats();

    }
  );


document.addEventListener(
  "DOMContentLoaded",
  updateStats
);

</script>

</body>
</html>
